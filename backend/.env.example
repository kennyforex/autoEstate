# Server
PORT=3001
NODE_ENV=development

# Absolute path where uploads are stored and served from /uploads (logos, videos, skills).
# Strongly recommended in production so writes and express.static always match (PM2/Docker cwd-safe).
# If you nginx-alias /uploads/, use this same path. Example: /var/www/foodflow/backend/uploads
# UPLOAD_PATH=

# MongoDB
MONGODB_URI=mongodb://localhost:27017/foodflow

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_REGION=us

# Evolution API
EVOLUTION_API_URL=https://evolution-api-evolution-api.4kkzfp.easypanel.host
EVOLUTION_API_KEY=your-evolution-api-key

# OpenRouter (for image/audio/video analysis)
OPENROUTER_API_KEY=your-openrouter-api-key
# Intent router (fast model): JSON classifier must exceed this confidence (0–1) to auto-force execute_skill
# AGENT_ROUTER_FORCE_SKILL_MIN_CONFIDENCE=0.85
# Optional: Video model (default: bytedance-seed/seed-1.6-flash)
# Alternatives: z-ai/glm-4.6v, amazon/nova-2-lite-v1, nvidia/nemotron-nano-12b-v2-vl
# Note: Google Gemini is not recommended (restricted in some regions, AI Studio only supports YouTube)
# OPENROUTER_VIDEO_MODEL=bytedance-seed/seed-1.6-flash

# Webhook (for Evolution callbacks)
WEBHOOK_BASE_URL=https://your-backend-url.com

# Google Sheets (optional fallback): cake order log if skill YAML has no orderSheetId
# GOOGLE_MILLE_ORDER_SHEET_ID=

# Payment reminder job (proactive WhatsApp from Sheet — optional)
# Uses the same column headers as cake order sheets: Order ID, Phone, Payment Status, Price (HKD), Customer
# PAYMENT_REMINDER_ENABLED=true
# PAYMENT_REMINDER_CRON=0 10 * * *
# PAYMENT_REMINDER_TZ=Asia/Hong_Kong
# PAYMENT_REMINDER_GOOGLE_USER_ID=<MongoDB User _id of account with Google OAuth>
# PAYMENT_REMINDER_SPREADSHEET_ID=<sheet id from URL>
# PAYMENT_REMINDER_SHEET_NAME=Cake orders
# PAYMENT_REMINDER_CHANNEL_ID=<MongoDB Channel _id for WhatsApp>
# PAYMENT_REMINDER_COOLDOWN_HOURS=72
# PAYMENT_REMINDER_UNPAID_STATUSES=未付,Pending,Unpaid,pending,未付款,Partial
# PAYMENT_REMINDER_MESSAGE_TEMPLATE=您好，我們留意到訂單 {orderId} 尚有款項待付（{amount}）。請盡快完成付款，謝謝！
# HTTP trigger: POST /api/cron/payment-reminder/run  Header: X-Cron-Secret: <secret>
# PAYMENT_REMINDER_CRON_SECRET=your-long-random-secret

# Skill schedule → Playground socket push (test; no LLM per tick)
# SKILL_SCHEDULE_ENABLED=true
# If set, overrides DB cron and pushes every N ms to the assistant Playground room:
# SKILL_SCHEDULE_TEST_INTERVAL_MS=15000
# PLAYGROUND_SCHEDULE_TEST_ASSISTANT_ID=<Assistant MongoDB _id>
# PLAYGROUND_SCHEDULE_TEST_SKILL_SLUG=hello-cron-test
# Otherwise: skills with scheduleEnabled in DB + assistants that bind the skill use scheduleCron (5 or 6 fields).

# Scheduled jobs (user-defined cron → agent run + optional WhatsApp summary)
# SCHEDULED_JOBS_ENABLED=true

# ── Agent tools: documents, PDF, files, web (see backend/docs/WEB_BROWSER_TOOLS.md)
# Google OAuth must include Docs scope — reconnect Google after upgrade (backend/docs/GOOGLE_OAUTH_SCOPES.md)
# WEB_FETCH_ALLOWLIST_ORIGINS=https://example.com
# ENABLE_WEB_FETCH_BROWSER=false
# WEB_BROWSER_ALLOW_INTERACTION=false
# Set true to allow fill/click/type/press/download/scroll/select_option (navigate/screenshot/get_text still work with ENABLE only).
# npx playwright install chromium
# LibreOffice (office_files docx_to_pdf — headless conversion on the server)
# LIBREOFFICE_SOFFICE_PATH=/usr/bin/soffice
# On macOS (default candidate if soffice is not on PATH): /Applications/LibreOffice.app/Contents/MacOS/soffice
# LIBREOFFICE_CONVERT_TIMEOUT_MS=120000

# AGENT_FETCH_MAX_BYTES=15728640
# AGENT_TEXT_OUTPUT_MAX_CHARS=500000
# AGENT_TEMP_FILE_TTL_MS=300000
# WEB_FETCH_MAX_SELECTOR_KEYS=20
# WEB_BROWSER_NAV_TIMEOUT_MS=45000
# WEB_BROWSER_MAX_ACTION_MS=60000
# WEB_BROWSER_SCREENSHOT_MAX_BYTES=12582912
# WEB_BROWSER_DOWNLOAD_MAX_BYTES=26214400
# WEB_BROWSER_MAX_SELECTOR_LENGTH=4000
# WEB_BROWSER_MAX_FILENAME_LENGTH=200

# Web search (Brave)
# BRAVE_SEARCH_API_KEY=

# Email (team invite): configure SMTP in Settings > General > Email (not env).

# Video analysis: public URL of this backend (no trailing slash).
# OpenRouter fetches the video from this URL; must be reachable from the internet.
# For local dev use a tunnel (e.g. ngrok) and set BACKEND_PUBLIC_URL=https://your-ngrok-url
# If unset, falls back to WEBHOOK_BASE_URL or http://localhost:PORT
# BACKEND_PUBLIC_URL=https://api.example.com
